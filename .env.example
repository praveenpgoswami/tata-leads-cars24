# OEM Lead Dispatcher: environment variables.
# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables. Every value is server-only.

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
# Username of the single admin account.
ADMIN_USERNAME=admin

# bcrypt hash of the initial admin password. Generate it with:
#   npm run hash-password -- "your-password"
# Used only until the password is changed in the app; after that, the hash stored
# in Redis takes precedence.
# IMPORTANT: in .env files, Next.js expands "$", so escape every "$" as "\$".
# In the Vercel dashboard, paste the raw hash without backslashes.
ADMIN_PASSWORD_HASH=\$2b\$12\$replace.with.output.of.hash.password.script.xxxxxxxxxx

# Secret for signing session JWTs. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Upstash Redis (stores the changed password hash, session version, and login rate limits)
# ---------------------------------------------------------------------------
# Set either the UPSTASH_* pair or the KV_* pair. The Vercel Marketplace Upstash
# integration injects one of these pairs automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# OEM lead API (docs/Adtrafix - lead contract tata api doc.docx)
# ---------------------------------------------------------------------------
# LIVE: base URL only (no path). The app appends /api/v1/consumer/leads/third-party-leads.
OEM_LIVE_BASE_URL=https://cms-bike-backend-prod.cars24.team
# LIVE token, sent as the "auth-token" header. Never commit it.
OEM_LIVE_TOKEN=

# DEV: leave both empty to make DEV mode a dry run (payloads are built and validated,
# no network call is made). Set both to send DEV traffic to a UAT endpoint instead.
OEM_DEV_BASE_URL=
OEM_DEV_TOKEN=

# Optional: timeout per OEM request in milliseconds (1000–20000, default 8000).
# OEM_REQUEST_TIMEOUT_MS=8000
